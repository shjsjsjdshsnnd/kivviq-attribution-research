{
  "name": "@kivviq/growth-operator-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-only research contracts for the future Kivviq Growth Operator.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run architecture && npm run typecheck && npm test && npm run build",
    "architecture": "depcruise --config .dependency-cruiser.cjs src",
    "benchmark:diversity": "vitest run tests/generation/diversity-benchmark.test.ts --reporter=verbose",
    "benchmark:customers": "vitest run tests/customer_population/benchmark.test.ts --reporter=verbose",
    "test:step4": "vitest run tests/simulation --reporter=verbose",
    "test:step5": "vitest run tests/advertising_economics --reporter=verbose",
    "test:step6": "vitest run tests/cross_channel --reporter=verbose",
    "test:step7": "vitest run tests/ecommerce_economics --reporter=verbose",
    "test:step8": "vitest run tests/product_economics --reporter=verbose",
    "test:action-ontology": "vitest run tests/action_ontology --reporter=verbose",
    "test:action-translation": "vitest run tests/action_translation tests/simulator_intervention --reporter=verbose",
    "test:paid-media": "vitest run tests/paid_media --reporter=verbose",
    "test:pricing": "vitest run tests/pricing --reporter=verbose",
    "test:promotion": "vitest run tests/promotion --reporter=verbose",
    "test:shipping": "vitest run tests/shipping --reporter=verbose",
    "test:merchandising": "vitest run tests/merchandising --reporter=verbose",
    "test:inventory": "vitest run tests/inventory --reporter=verbose",
    "test:cro": "vitest run tests/cro --reporter=verbose",
    "test:lifecycle": "vitest run tests/lifecycle --reporter=verbose",
    "test:action-timing": "vitest run tests/action_timing --reporter=verbose",
    "test:canonical": "vitest run tests/canonical_action tests/population tests/action_timing tests/lifecycle --maxWorkers=1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ground-truth": "./dist/ground_truth/index.js",
    "./evaluation": "./dist/evaluation/index.js",
    "./generation": "./dist/generation/index.js",
    "./customer-population": "./dist/customer_population/index.js",
    "./simulation": "./dist/simulation/index.js",
    "./advertising-economics": "./dist/advertising_economics/index.js",
    "./cross-channel": "./dist/cross_channel/index.js",
    "./ecommerce-economics": "./dist/ecommerce_economics/index.js",
    "./product-economics": "./dist/product_economics/index.js",
    "./action-ontology": "./dist/action_ontology/index.js",
    "./simulator-intervention": "./dist/simulator_intervention/index.js",
    "./action-translation": "./dist/action_translation/index.js",
    "./paid-media": "./dist/paid_media/index.js",
    "./pricing": "./dist/pricing/index.js",
    "./promotion": "./dist/promotion/index.js",
    "./shipping": "./dist/shipping/index.js",
    "./merchandising": "./dist/merchandising/index.js",
    "./inventory": "./dist/inventory/index.js",
    "./cro": "./dist/cro/index.js",
    "./lifecycle": "./dist/lifecycle/index.js",
    "./action-timing": "./dist/action_timing/index.js",
    "./canonical-action": "./dist/canonical_action/index.js",
    "./population": "./dist/population/index.js"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "zod": "^3.25.76"
  }
}
