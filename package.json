{
  "name": "@kivviq/growth-operator-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-only research contracts for the future Kivviq Growth Operator.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run architecture && npm run typecheck && npm test && npm run build",
    "architecture": "depcruise --config .dependency-cruiser.cjs src",
    "benchmark:diversity": "vitest run tests/generation/diversity-benchmark.test.ts --reporter=verbose",
    "benchmark:customers": "vitest run tests/customer_population/benchmark.test.ts --reporter=verbose",
    "test:step4": "vitest run tests/simulation --reporter=verbose",
    "test:step5": "vitest run tests/advertising_economics --reporter=verbose"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ground-truth": "./dist/ground_truth/index.js",
    "./evaluation": "./dist/evaluation/index.js",
    "./generation": "./dist/generation/index.js",
    "./customer-population": "./dist/customer_population/index.js",
    "./simulation": "./dist/simulation/index.js",
    "./advertising-economics": "./dist/advertising_economics/index.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "dependency-cruiser": "^16.10.4"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
